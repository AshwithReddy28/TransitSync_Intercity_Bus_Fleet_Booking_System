# TransitSync Environment Variables Template
# Copy this file to .env or set variables in your cloud provider environment

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/transitsync_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=root

# Server Port
PORT=8080

# Security & JWT (Must be at least 256 bits in production)
JWT_SECRET=4c65637572655472616e73697453796e633230323653757065725365637265744b65793132333435
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap Initial Administrator
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@transitsync.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@Transit2026!
ADMIN_BOOTSTRAP_NAME=Super Administrator

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8080
